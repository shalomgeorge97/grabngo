<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="@string/order_list_title"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:ignore="RtlSymmetry,VisualLintSystemUi" />

    <!-- Content area -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.GrabNGo.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/order_list_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                tools:ignore="VisualLintTextFieldSize" />
        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/filterToggleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                app:checkedButton="@id/btnAll"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAll"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="68dp"
                    android:text="@string/order_filter_all"
                    android:textAllCaps="false"
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    app:backgroundTint="@color/selector_filter_bg"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/selector_filter_stroke"
                    app:strokeWidth="1.5dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPending"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="84dp"
                    android:text="@string/order_filter_pending"
                    android:textAllCaps="false"
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    app:backgroundTint="@color/selector_filter_bg"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/selector_filter_stroke"
                    app:strokeWidth="1.5dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccepted"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="88dp"
                    android:text="@string/order_filter_accepted"
                    android:textAllCaps="false"
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    app:backgroundTint="@color/selector_filter_bg"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/selector_filter_stroke"
                    app:strokeWidth="1.5dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRejected"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="84dp"
                    android:text="@string/status_rejected"
                    android:textAllCaps="false"
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    app:backgroundTint="@color/selector_filter_bg"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/selector_filter_stroke"
                    app:strokeWidth="1.5dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompleted"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="92dp"
                    android:text="@string/status_completed"
                    android:textAllCaps="false"
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    app:backgroundTint="@color/selector_filter_bg"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/selector_filter_stroke"
                    app:strokeWidth="1.5dp"
                    tools:ignore="TouchTargetSizeCheck" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </HorizontalScrollView>

<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="16dp"-->
<!--            android:layout_marginBottom="8dp"-->
<!--            android:text="@string/home_restaurants_heading"-->
<!--            android:textAppearance="@style/TextAppearance.GrabNGo.Heading" />-->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrders"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:ignore="NestedWeights" />
    </LinearLayout>


    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint"
        app:menu="@menu/menu_customer_bottom_nav" />

</LinearLayout>
