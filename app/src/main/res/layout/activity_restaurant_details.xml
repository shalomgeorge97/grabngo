<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/background"
android:orientation="vertical"
tools:context=".RestaurantDetails">

<!-- Top bar -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/primary"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/action_back"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@android:color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/details_title"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>

<!-- Content -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Restaurant info -->
    <TextView
        android:id="@+id/tvRestaurantName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.GrabNGo.Title"
        tools:text="Restaurant name" />

    <TextView
        android:id="@+id/tvRestaurantAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.GrabNGo.Caption"
        tools:text="123 Main St, New Westminster" />

    <TextView
        android:id="@+id/tvRestaurantInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:textAppearance="@style/TextAppearance.GrabNGo.Caption"
        tools:text="9am - 9pm  |  604-555-0101  |  Rating 4.5" />

    <!-- Search -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.GrabNGo.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/details_search_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Food list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFoodItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <!-- Reserve -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReserve"
        style="@style/Widget.GrabNGo.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/details_reserve" />
</LinearLayout>

</LinearLayout>