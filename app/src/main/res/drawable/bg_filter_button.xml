<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected State (Light Green Fill + Dark Green Border) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8F5E9" />
            <stroke android:width="1.5dp" android:color="#2E5B32" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Unselected State (White Fill + Very Faint Border) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#F0F0F0" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>